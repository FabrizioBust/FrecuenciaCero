--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4400000000000000000000000000006, type: 3}
  m_Name: Radio_Supervisor
  m_EditorClassIdentifier:
  lines:
  - speaker: "RADIO"
    text: "Krrrr... krrrr..."
    soundCue: "radio_static"
  - speaker: "LEO"
    text: "Central, aquí Leo. He llegado al retén de Cima del Águila. ¿Me reciben?"
    soundCue: ""
  - speaker: "SUPERVISOR"
    text: "Te recibimos, Leo. La señal está bastante deteriorada. ¿Cómo está el lugar?"
    soundCue: ""
  - speaker: "LEO"
    text: "Abandonado. No parece que alguien haya trabajado aquí en años."
    soundCue: ""
  - speaker: "SUPERVISOR"
    text: "Necesitamos recuperar la comunicación con la torre. Según nuestros registros, hay un generador auxiliar cerca del antiguo camino de servicio."
    soundCue: ""
  - speaker: "LEO"
    text: "¿No debería haber personal de mantenimiento en esta zona?"
    soundCue: ""
  - speaker: "SUPERVISOR"
    text: "No. La instalación fue cerrada hace décadas. Tú eres el único técnico autorizado para ingresar esta noche."
    soundCue: ""
  - speaker: "LEO"
    text: "Entendido. Revisaré el generador."
    soundCue: ""
  - speaker: "RADIO"
    text: "Krrrr..."
    soundCue: "radio_static"
